{
  "name": "dungeons-and-dragons",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "lint": "yarn workspaces foreach -A run lint",
    "lint:fix": "yarn workspaces foreach -A run lint:fix",
    "test": "yarn workspaces foreach -A run test",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "dev": "concurrently \"yarn workspace api dev\" \"yarn workspace web dev\""
  },
  "devDependencies": {
    "@juuso.piikkila/eslint-config-typescript": "^4.5.0",
    "concurrently": "^9.2.1",
    "eslint": "~9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0"
  }
}
