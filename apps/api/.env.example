# PostgreSQL connection string (with pgvector enabled)
DATABASE_URL=postgresql://dnd:dnd@localhost:5432/dnd

# Redis connection string
REDIS_URL=redis://localhost:6379

# Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI API key (get from https://www.voyageai.com)
VOYAGE_API_KEY=pa-...

# JWT signing secret (generate a long random string, e.g. openssl rand -hex 64)
JWT_SECRET=change-me-in-production

# LLM model names (set via config, never hardcoded)
LLM_DM_MODEL=claude-sonnet-4-6
LLM_BACKGROUND_MODEL=claude-haiku-4-5-20251001

# Allowed origin for CORS (set to the Nuxt web app URL)
WEB_ORIGIN=http://localhost:4000

# HTTP port for the NestJS server
PORT=3000
